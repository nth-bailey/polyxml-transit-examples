#!/usr/bin/env bash
set -e

# Pre-commit hook: Verify Rust formatting
echo "🔍 Checking Rust formatting..."
if command -v cargo >/dev/null 2>&1 && [ -f examples/rust/Cargo.toml ]; then
    cargo fmt --manifest-path examples/rust/Cargo.toml -- --check || {
        echo "❌ cargo fmt check failed. Run 'cargo fmt --manifest-path examples/rust/Cargo.toml' to format."
        exit 1
    }
fi
